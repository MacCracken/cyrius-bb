# sound.cyr — ALSA PCM SFX playback via vani's audio_* core shim.
# See ADR 0003.
#
# The present.cyr analogue for audio: environment-specific, NOT unit-
# tested, and degrades gracefully. Routes the synth's raw 8-bit PCM
# (src/audio.cyr) to /dev/snd/pcmC{card}D{device}p through vani-core
# (vendor/vani-core.cyr) — direct ALSA ioctls, no FFI, no PulseAudio /
# PipeWire. With no sound card (CI / no /dev/snd) audio_open_playback
# returns 0, snd_dev stays 0, and sound_play is a silent no-op — the
# game runs unchanged. Requires src/audio.cyr (the synth) and the
# vendor/vani-core.cyr include (supplies the audio_* symbols), both
# before this module in main.cyr's chain.
#
# Replaces the legacy OSS /dev/dsp sink: that was inaudible on modern
# ALSA-only systems (no /dev/dsp). vani reaches ALSA with no banned C
# library, so the no-FFI rule (docs/architecture/001-no-ffi-audio.md)
# is satisfied by a real device path now, not just by OSS.
#
# Note: vani's audio_write is a blocking WRITEI ioctl (the old OSS sink
# was non-blocking fire-and-forget). SFX are short square-wave blips, so
# the ~60 fps loop is not stalled in practice — same pattern cyrius-
# polyomino uses. If overlap / latency ever bites, vani's full profile
# adds a ring buffer + XRUN recovery.

enum SoundDev {
    SND_CARD = 1;     # vani's verified analog target (ALC897); edit per box
    SND_DEVICE = 0;   # NB: card 0 device 0 often has no PCM — see vani state.md
}

var snd_dev = 0; # vani device handle; 0 = no device (silent degrade)

# Open the ALSA playback device at the synth's format (8-bit mono at
# AUDIO_RATE). Returns the handle, or 0 if no device is available (the
# game then runs silent). Best-effort, mirrors the old sound_open contract.
fn sound_open(): i64 {
    snd_dev = audio_open_playback(SND_CARD, SND_DEVICE);
    if (snd_dev == 0) {
        return 0;
    }
    audio_set_params(snd_dev, AUDIO_RATE, 1, 8); # rate, channels, bit depth
    audio_prepare(snd_dev);
    return snd_dev;
}

# Play SFX id once. No-op when muted or when no device is open. 8-bit mono
# means sfx_len bytes == frames; audio_write_bytes computes frames from the
# byte count. Concurrent SFX do not mix yet — a playtest-driven refinement.
fn sound_play(id): i64 {
    if (audio_muted() == 1) {
        return 0;
    }
    if (snd_dev == 0) {
        return 0;
    }
    audio_write_bytes(snd_dev, sfx_buf(id), sfx_len(id));
    return 0;
}

fn sound_close(): i64 {
    if (snd_dev != 0) {
        audio_drain(snd_dev);
        audio_close(snd_dev);
        snd_dev = 0;
    }
    return 0;
}
