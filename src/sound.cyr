# sound.cyr — ALSA PCM SFX playback via vani's audio_* core shim.
# See ADR 0003.
#
# The present.cyr analogue for audio: environment-specific, and degrades
# gracefully. Routes the synth's prebuilt SFX (src/audio.cyr — 48 kHz
# S16_LE stereo, the device's own format) to /dev/snd/pcmC{card}D{device}p
# through vani-core (vendor/vani-core.cyr) — direct ALSA ioctls, no FFI, no
# PulseAudio / PipeWire. With no sound card (CI / no /dev/snd), or a device
# that refuses the format, snd_dev stays 0 and sound_play is a silent no-op
# — the game runs unchanged. The ioctl path needs a device, so it is not
# unit-tested; the pure pieces (the write-retry policy, the ring shape) are.
# Requires src/audio.cyr (the synth) and the vendor/vani-core.cyr include
# (the audio_* symbols + ALSA constants), both before this module in
# main.cyr's chain.
#
# Replaces the legacy OSS /dev/dsp sink: that was inaudible on modern
# ALSA-only systems (no /dev/dsp). vani reaches ALSA with no banned C
# library, so the no-FFI rule (docs/architecture/001-no-ffi-audio.md)
# is satisfied by a real device path now, not just by OSS.
#
# Stream model: the ring is fed only when a cue fires, so each cue ends
# with it running dry and the kernel stopping the stream (an XRUN — the
# default stop_threshold is the ring size); sound_play re-prepares and
# retries. vani's audio_write is a blocking WRITEI ioctl, so the ring is
# sized (SoundDev) to take a whole tick's cues without waiting. Concurrent
# cues queue back to back rather than mix — a mixer is a playtest-driven
# refinement.

# Playback target + ring shape. Card 1 device 0 is vani's verified analog
# target (the ALC897); card 0 device 0 often has no PCM — see vani
# state.md. Edit the card/device per box.
#
# Ring: 32 periods of 1024 frames = 32768 frames (~683 ms at 48 kHz).
# HD-Audio allows at most 32 periods, so a ring this deep needs 1024-frame
# periods. It holds the worst one-tick burst — a wall thud plus the
# game-over sting, 31,440 frames — so a write to an idle ring never blocks
# the ~60 fps loop. Left to pick, the kernel gives this codec a 1024-frame
# (21 ms) ring, and every cue longer than that would stall the loop for
# the rest of its length (~580 ms for the 600 ms sting).
enum SoundDev {
    SND_CARD = 1;
    SND_DEVICE = 0;
    SND_PERIOD_FRAMES = 1024;
    SND_BUFFER_FRAMES = 32768;
}

# Negative errnos audio_write surfaces that one audio_prepare recovers.
enum SoundErrno {
    SND_EPIPE = 32;    # XRUN: the ring ran dry and the kernel stopped the stream
    SND_ESTRPIPE = 86; # the PCM was suspended (system sleep)
}

var snd_dev = 0; # vani device handle; 0 = no device (silent degrade)

# Whether a failed audio_write is one audio_prepare fixes (1) or not (0).
# -EPIPE is the normal state between cues (see the stream model above):
# every write after the ring ran dry fails until a PREPARE. -ESTRPIPE
# (suspended) also recovers with a PREPARE, which the kernel accepts from
# SUSPENDED. Anything else (e.g. -ENODEV, an unplugged device) is not
# retried. Pure — the policy is unit-tested; the ioctls it drives are not.
fn sound_write_recoverable(w): i64 {
    if (w == (0 - SND_EPIPE)) {
        return 1;
    }
    if (w == (0 - SND_ESTRPIPE)) {
        return 1;
    }
    return 0;
}

# SW_PARAMS for one-shot cues on a ring of buffer_frames: start on the
# first frame written, stop when the ring runs dry (the XRUN sound_play
# recovers from), and have the kernel keep every frame past the queued
# audio zeroed (silence_threshold = silence_size = the whole ring). Without
# that, after each cue the DMA plays whatever an earlier cue left in the
# ring until the next period interrupt notices the underrun — up to one
# period (21 ms) of stale audio. vani's audio_set_sw_params pins both
# silence fields to 0, so this issues the ioctl on vani's handle itself,
# with the struct layout vani-core declares (AlsaSwParamsLayout); it is
# cyrius-polyomino's audio_set_sw_silence. Returns 0 or a negative errno.
fn sound_set_sw_silence(dev, period_frames, buffer_frames): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: the kernel owns the stream's ring and pacing — there is no
    # SW_PARAMS surface (vani's audio_set_sw_params is a no-op there too).
    return 0;
    #else
    var swp[136];
    memset(&swp, 0, SWP_SIZE);
    store32(&swp + SWP_PERIOD_STEP, 1);
    store64(&swp + SWP_AVAIL_MIN, period_frames);
    store64(&swp + SWP_XFER_ALIGN, 1);
    store64(&swp + SWP_START_THRESHOLD, 1);
    store64(&swp + SWP_STOP_THRESHOLD, buffer_frames);
    store64(&swp + SWP_SILENCE_THRESHOLD, buffer_frames);
    store64(&swp + SWP_SILENCE_SIZE, buffer_frames);
    return syscall(SYS_IOCTL, audio_fd(dev), SNDRV_PCM_IOCTL_SW_PARAMS, &swp);
    #endif
}

# Open the ALSA playback device in the synth's format (48 kHz S16_LE
# stereo) with the SoundDev ring. Returns the handle, or 0 if there is no
# usable device (the game then runs silent). If the open, HW_PARAMS, or
# PREPARE fails, the device is closed and snd_dev stays 0, so no write
# ever reaches an unconfigured PCM.
fn sound_open(): i64 {
    snd_dev = audio_open_playback(SND_CARD, SND_DEVICE);
    if (snd_dev == 0) {
        return 0;
    }
    var r = audio_set_params_fmt(snd_dev, AUDIO_RATE, AUDIO_CHANNELS,
      SND_PCM_FORMAT_S16_LE, SND_PERIOD_FRAMES, SND_BUFFER_FRAMES);
    if (r == 0) {
        # Best-effort: if refused, the kernel keeps its default sw params
        # (same start/stop), just without the silence fill.
        sound_set_sw_silence(snd_dev, SND_PERIOD_FRAMES, SND_BUFFER_FRAMES);
    } else {
        # The device refuses this ring shape: let the kernel pick period
        # and buffer. Cues still play, but a small default ring blocks the
        # loop on long cues, and there is no silence fill (the ring size is
        # not known here).
        r = audio_set_params_fmt(snd_dev, AUDIO_RATE, AUDIO_CHANNELS,
          SND_PCM_FORMAT_S16_LE, 0, 0);
    }
    if (r == 0) {
        r = audio_prepare(snd_dev);
    }
    if (r != 0) {
        audio_close(snd_dev);
        snd_dev = 0;
    }
    return snd_dev;
}

# Play SFX id once. No-op (returns 0) when muted or when no device is open.
# Otherwise returns the frames queued (0 if the device refused them). A cue
# fired while another is still playing queues behind it in the ring.
fn sound_play(id): i64 {
    if (audio_muted() == 1) {
        return 0;
    }
    if (snd_dev == 0) {
        return 0;
    }
    var w = audio_write(snd_dev, sfx_buf(id), sfx_len(id));
    if (sound_write_recoverable(w) == 1) {
        # The previous cue ran the ring dry (or the PCM was suspended):
        # re-arm the stream and retry once, which restarts playback here.
        if (audio_prepare(snd_dev) == 0) {
            w = audio_write(snd_dev, sfx_buf(id), sfx_len(id));
        }
    }
    if (w < 0) {
        return 0;
    }
    return w;
}

fn sound_close(): i64 {
    if (snd_dev != 0) {
        audio_drain(snd_dev);
        audio_close(snd_dev);
        snd_dev = 0;
    }
    return 0;
}
