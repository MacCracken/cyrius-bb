include "vendor/vani-core.cyr"   # the audio_* symbols src/sound.cyr calls
include "src/sound.cyr"

fn test_smoke() {
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");
    return 0;
}

# |a - b| < tol, for fixed-point approx checks (rounding in unit vectors).
fn near(a, b, tol): i64 {
    if (fixed_abs(a - b) < tol) { return 1; }
    return 0;
}

fn test_fixed() {
    test_group("fixed");
    assert_eq(fixed_from_int(5), 5 * FIXED_ONE, "from_int(5)");
    assert_eq(fixed_to_int(fixed_from_int(7)), 7, "roundtrip 7");
    assert_eq(fixed_mul(fixed_from_int(2), fixed_from_int(3)), fixed_from_int(6), "mul 2*3 = 6");
    assert_eq(fixed_div(fixed_from_int(6), fixed_from_int(2)), fixed_from_int(3), "div 6/2 = 3");
    assert_eq(asr(0 - 16, 2), 0 - 4, "asr floors -16>>2 = -4");
    assert_eq(asr(16, 2), 4, "asr 16>>2 = 4");
    assert_eq(fixed_abs(0 - fixed_from_int(3)), fixed_from_int(3), "abs(-3) = 3");
    assert_eq(fixed_clamp(fixed_from_int(10), 0, fixed_from_int(5)), fixed_from_int(5), "clamp hi");
    assert_eq(fixed_div(FIXED_ONE, 0), FIXED_MAX, "div by zero -> MAX");
    return 0;
}

fn test_geom() {
    test_group("geom");
    assert_eq(aabb_overlap(0, 0, fixed_from_int(4), fixed_from_int(4), fixed_from_int(2), fixed_from_int(2), fixed_from_int(4), fixed_from_int(4)), 1, "overlap yes");
    assert_eq(aabb_overlap(0, 0, fixed_from_int(2), fixed_from_int(2), fixed_from_int(10), 0, fixed_from_int(2), fixed_from_int(2)), 0, "overlap no");
    assert_eq(reflect(fixed_from_int(3)), 0 - fixed_from_int(3), "reflect + -> -");
    assert_eq(reflect(0 - fixed_from_int(3)), fixed_from_int(3), "reflect - -> +");
    var cx = fixed_from_int(100);
    var half = fixed_from_int(20);
    assert_eq(paddle_english(cx, cx, half), 0, "english centre = 0");
    assert_eq(paddle_english(cx + half, cx, half), FIXED_ONE, "english right edge = +1");
    assert_eq(paddle_english(cx - half, cx, half), 0 - FIXED_ONE, "english left edge = -1");
    assert_eq(paddle_english(cx + half + half, cx, half), FIXED_ONE, "english beyond clamps to +1");
    return 0;
}

fn test_ball() {
    test_group("ball");
    var b = ball_new(fixed_from_int(10), fixed_from_int(20), fixed_from_int(3), fixed_from_int(5), fixed_from_int(2));
    assert_eq(ball_x(b), fixed_from_int(10), "ball x");
    assert_eq(ball_vx(b), fixed_from_int(3), "ball vx");
    assert_eq(ball_r(b), fixed_from_int(2), "ball r");
    ball_integrate(b);
    assert_eq(ball_x(b), fixed_from_int(13), "integrate x += vx");
    assert_eq(ball_y(b), fixed_from_int(25), "integrate y += vy");
    ball_set_vx(b, 0 - fixed_from_int(1));
    assert_eq(ball_vx(b), 0 - fixed_from_int(1), "set vx negative");
    return 0;
}

fn test_paddle() {
    test_group("paddle");
    var p = paddle_new(fixed_from_int(50), fixed_from_int(190), fixed_from_int(20), fixed_from_int(4));
    assert_eq(paddle_cx(p), fixed_from_int(60), "centre = x + w/2");
    paddle_move(p, fixed_from_int(5), 0, fixed_from_int(200));
    assert_eq(paddle_x(p), fixed_from_int(55), "move right by 5");
    paddle_move(p, fixed_from_int(1000), 0, fixed_from_int(200));
    assert_eq(paddle_x(p), fixed_from_int(180), "clamp right edge to 200");
    paddle_move(p, 0 - fixed_from_int(1000), 0, fixed_from_int(200));
    assert_eq(paddle_x(p), 0, "clamp left to 0");
    return 0;
}

fn test_bricks() {
    test_group("bricks");
    var g = bricks_new(3, 2, fixed_from_int(4), fixed_from_int(4), fixed_from_int(10), fixed_from_int(5), fixed_from_int(2), fixed_from_int(2), 50);
    assert_eq(bricks_total(g), 6, "total bricks");
    assert_eq(bricks_alive_count(g), 6, "all alive");
    assert_eq(brick_x(g, 1), fixed_from_int(16), "brick 1 x (col 1)");
    assert_eq(brick_y(g, 1), fixed_from_int(4), "brick 1 y (row 0)");
    assert_eq(brick_x(g, 3), fixed_from_int(4), "brick 3 x (col 0)");
    assert_eq(brick_y(g, 3), fixed_from_int(11), "brick 3 y (row 1)");
    assert_eq(brick_destroy(g, 0), 50, "destroy returns value");
    assert_eq(brick_alive(g, 0), 0, "brick 0 dead");
    assert_eq(bricks_alive_count(g), 5, "count decremented");
    assert_eq(brick_destroy(g, 0), 0, "re-destroy returns 0");
    assert_eq(bricks_alive_count(g), 5, "count unchanged on re-destroy");
    return 0;
}

fn test_world_wall() {
    test_group("world wall");
    var b = ball_new(fixed_from_int(197), fixed_from_int(100), fixed_from_int(5), 0, fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(10), fixed_from_int(10), fixed_from_int(8), fixed_from_int(4), 0, 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    assert_eq(ball_vx(b), 0 - fixed_from_int(5), "right wall reflects vx");
    assert_eq(ball_x(b), fixed_from_int(198), "right wall clamps x to w-r");
    assert_eq(world_state(wd), WS_PLAYING, "still playing");
    assert_eq((world_events(wd) & EV_WALL) != 0, 1, "wall bounce raises EV_WALL");
    return 0;
}

fn test_world_top() {
    test_group("world top");
    var b = ball_new(fixed_from_int(100), fixed_from_int(3), 0, 0 - fixed_from_int(5), fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(150), fixed_from_int(150), fixed_from_int(8), fixed_from_int(4), 0, 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    assert_eq(ball_vy(b), fixed_from_int(5), "top wall reflects vy");
    assert_eq(ball_y(b), fixed_from_int(2), "top clamps y to r");
    return 0;
}

fn test_world_paddle() {
    test_group("world paddle");
    var b = ball_new(fixed_from_int(100), fixed_from_int(187), 0, fixed_from_int(5), fixed_from_int(2));
    var p = paddle_new(fixed_from_int(90), fixed_from_int(190), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(10), fixed_from_int(10), fixed_from_int(8), fixed_from_int(4), 0, 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    # speed-conserving rebound: a centre hit leaves straight up at the
    # world's target speed (4 here), independent of the incoming vy (5).
    assert_eq(ball_vy(b), 0 - fixed_from_int(4), "centre hit -> up at target speed");
    assert_eq(ball_vx(b), 0, "centre hit -> no english");
    assert_eq(ball_y(b), fixed_from_int(188), "ball nudged above paddle");
    assert_eq(world_state(wd), WS_PLAYING, "still playing after paddle");
    assert_eq((world_events(wd) & EV_PADDLE) != 0, 1, "paddle bounce raises EV_PADDLE");
    return 0;
}

fn test_world_brick() {
    test_group("world brick");
    var b = ball_new(fixed_from_int(50), fixed_from_int(48), 0, fixed_from_int(2), fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(2, 1, fixed_from_int(45), fixed_from_int(45), fixed_from_int(10), fixed_from_int(10), fixed_from_int(20), 0, 100);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    assert_eq(world_score(wd), 100, "brick destroyed -> score += value");
    assert_eq(bricks_alive_count(g), 1, "one brick left");
    assert_eq(brick_alive(g, 0), 0, "brick 0 destroyed");
    assert_eq(ball_vy(b), 0 - fixed_from_int(2), "brick reflects vy");
    assert_eq(world_state(wd), WS_PLAYING, "playing, bricks remain");
    assert_eq((world_events(wd) & EV_BRICK) != 0, 1, "brick hit raises EV_BRICK");
    return 0;
}

fn test_world_lost() {
    test_group("world lost");
    var b = ball_new(fixed_from_int(100), fixed_from_int(204), 0, fixed_from_int(2), fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(10), fixed_from_int(10), fixed_from_int(8), fixed_from_int(4), 0, 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    assert_eq(world_lives(wd), 2, "life lost");
    assert_eq(world_state(wd), WS_BALL_LOST, "ball lost state");
    return 0;
}

fn test_world_clear() {
    test_group("world clear");
    var b = ball_new(fixed_from_int(50), fixed_from_int(48), 0, fixed_from_int(2), fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(45), fixed_from_int(45), fixed_from_int(10), fixed_from_int(10), 0, 0, 100);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    assert_eq(bricks_alive_count(g), 0, "last brick gone");
    assert_eq(world_state(wd), WS_LEVEL_CLEAR, "level clear");
    assert_eq(world_score(wd), 100, "score for last brick");
    return 0;
}

fn test_framebuf() {
    test_group("framebuf");
    var f = fb_new(8, 4);
    assert_eq(fb_w(f), 8, "width");
    assert_eq(fb_h(f), 4, "height");
    fb_clear(f, 0, 0, 0);
    assert_eq(fb_get(f, 0, 0, 0), 0, "clear -> 0");
    # fill rect x[2,5) y[1,3)
    fb_fill_rect(f, 2, 1, 3, 2, 100, 150, 200);
    assert_eq(fb_get(f, 2, 1, 0), 100, "rect R");
    assert_eq(fb_get(f, 2, 1, 1), 150, "rect G");
    assert_eq(fb_get(f, 4, 2, 2), 200, "rect B interior");
    assert_eq(fb_get(f, 0, 0, 0), 0, "outside rect stays bg");
    assert_eq(fb_get(f, 5, 1, 0), 0, "right edge exclusive");
    # clipping: rect runs past the right/bottom edges, must not crash
    fb_fill_rect(f, 6, 0, 10, 10, 255, 255, 255);
    assert_eq(fb_get(f, 7, 3, 0), 255, "clipped rect fills in-bounds");
    # out-of-bounds set is a no-op
    assert_eq(fb_set(f, 100, 100, 1, 2, 3), 0, "oob set no-op");
    # ...and an off-the-edge x must not wrap into a neighbouring row
    fb_clear(f, 0, 0, 0);
    fb_set(f, 8, 0, 9, 9, 9);
    assert_eq(fb_get(f, 0, 1, 0), 0, "x == w does not wrap to the next row");
    fb_set(f, 0 - 1, 1, 9, 9, 9);
    assert_eq(fb_get(f, 7, 0, 0), 0, "x < 0 does not wrap to the previous row");
    # out-of-range reads are 0, not a neighbouring pixel
    fb_clear(f, 200, 200, 200);
    assert_eq(fb_get(f, 8, 0, 0), 0, "fb_get past the right edge -> 0");
    assert_eq(fb_get(f, 0, 4, 0), 0, "fb_get past the bottom -> 0");
    assert_eq(fb_get(f, 0 - 1, 1, 0), 0, "fb_get x < 0 -> 0");
    assert_eq(fb_get(f, 0, 0 - 1, 0), 0, "fb_get y < 0 -> 0");
    var strip = fb_new(16, 1);
    var guard = alloc(16);
    memset(guard, 200, 16);
    assert_eq(fb_get(strip, 0, 1, 0), 0, "fb_get past the last row, not the next allocation");
    # a PPM written over a longer file leaves no stale tail
    var path = test_scratch("bb_ppm_fixture");
    var fd = file_open(path, 577, 420);
    var junk = alloc(5000);
    memset(junk, 65, 5000);
    file_write(fd, junk, 5000);
    file_close(fd);
    assert_eq(fb_write_ppm(f, path), 0, "ppm written");
    var back = alloc(6000);
    assert_eq(file_read_all(path, back, 6000), 107, "11-byte header + 96 pixel bytes, nothing after");
    sys_unlink(path);
    return 0;
}

fn test_present() {
    test_group("present");
    assert_eq(present_usable(1920, 1080, 32, 200, 150), 1, "32-bpp 1080p is usable");
    assert_eq(present_usable(200, 150, 32, 200, 150), 1, "an exact fit is usable");
    assert_eq(present_usable(199, 150, 32, 200, 150), 0, "too narrow is refused");
    assert_eq(present_usable(200, 149, 32, 200, 150), 0, "too short is refused");
    assert_eq(present_usable(1920, 1080, 16, 200, 150), 0, "16 bpp is refused");
    assert_eq(present_fit(1920, 1080, 200, 150), 4, "scale caps at 4");
    assert_eq(present_fit(640, 480, 200, 150), 3, "scale 3 fits 640x480");
    assert_eq(present_fit(800, 300, 200, 150), 2, "height limits the scale");
    assert_eq(present_fit(1000, 150, 200, 150), 1, "scale 1 at an exact height");
    assert_eq(present_offset(3, 10, 20, 0, 0, 7680), 13 * 7680 + 80, "row + centring");
    assert_eq(present_offset(0, 0, 0, 1080, 0, 7680), 1080 * 7680, "a panned console starts at yoffset");
    assert_eq(present_offset(0, 0, 0, 0, 8, 7680), 32, "xoffset is in pixels");
    return 0;
}

# The bytes ESC + s, for feeding the input decoder.
var esc_buf[8];
fn esc_seq(s): i64 {
    store8(&esc_buf, 27);
    memcpy(&esc_buf + 1, s, strlen(s));
    return &esc_buf;
}

fn test_input_decode() {
    test_group("input decode");
    input_esc = ESC_IDLE;
    assert_eq(input_decode_actions(esc_seq("[C"), 3), ACT_RIGHT, "ESC [ C -> RIGHT");
    assert_eq(input_decode_actions(esc_seq("[D"), 3), ACT_LEFT, "ESC [ D -> LEFT");
    assert_eq(input_decode_actions(esc_seq("[A"), 3), 0, "up has no gameplay action");
    assert_eq(input_esc, ESC_IDLE, "a whole sequence leaves the decoder idle");
    # an arrow split across reads is still an arrow, never a quit
    assert_eq(input_decode_actions(esc_seq(""), 1), 0, "ESC alone waits for the next read");
    assert_eq(input_decode_actions("[C", 2), ACT_RIGHT, "the rest completes the arrow");
    assert_eq(input_decode_actions(esc_seq("["), 2), 0, "ESC [ alone waits");
    assert_eq(input_decode_actions("C", 1), ACT_RIGHT, "its final byte completes the arrow");
    # 11 queued arrows are 33 bytes, so a 32-byte read ends inside the last
    var burst = alloc(33);
    var i = 0;
    while (i < 11) {
        store8(burst + i * 3, 27);
        store8(burst + i * 3 + 1, 91);
        store8(burst + i * 3 + 2, 67);
        i += 1;
    }
    assert_eq(input_decode_actions(burst, 32), ACT_RIGHT, "a full read ending mid-arrow does not quit");
    assert_eq(input_decode_actions(burst + 32, 1), ACT_RIGHT, "the next read finishes that arrow");
    assert_eq(input_esc, ESC_IDLE, "and leaves the decoder idle");
    # a lone ESC quits one poll later, once
    assert_eq(input_decode_actions(esc_seq(""), 1), 0, "lone ESC waits one poll");
    assert_eq(input_decode_actions(0, 0), ACT_QUIT, "an empty read makes it a quit");
    assert_eq(input_decode_actions(0, 0), 0, "only once");
    # an open CSI cannot be a lone ESC, so an empty read leaves it open
    assert_eq(input_decode_actions(esc_seq("["), 2), 0, "ESC [ waits");
    assert_eq(input_decode_actions(0, 0), 0, "an empty read does not quit an open CSI");
    assert_eq(input_decode_actions("D", 1), ACT_LEFT, "and the sequence still completes");
    # the other encodings of a key
    assert_eq(input_decode_actions(esc_seq("OC"), 3), ACT_RIGHT, "application-mode right");
    assert_eq(input_decode_actions(esc_seq("OD"), 3), ACT_LEFT, "application-mode left");
    assert_eq(input_decode_actions(esc_seq("[1;5C"), 6), ACT_RIGHT, "Ctrl+right is still right");
    assert_eq(input_decode_actions(esc_seq("[3~"), 4), 0, "Delete is nothing");
    assert_eq(input_decode_actions(esc_seq("[[A"), 4), 0, "a console F1 is nothing");
    input_feed(27);
    input_feed(91);
    input_feed(91);
    assert_eq(input_feed(65), KEY_NONE, "F1's letter is swallowed, not typed");
    assert_eq(input_esc, ESC_IDLE, "and the decoder is idle again");
    # ESC + another byte is an Esc press, whole
    assert_eq(input_decode_actions(esc_seq("a"), 2), ACT_QUIT, "Alt+a -> QUIT");
    assert_eq(input_esc, ESC_IDLE, "idle afterward");
    # a new ESC cuts off a sequence in progress and starts its own
    assert_eq(input_decode_actions(esc_seq("[1"), 3), 0, "open CSI");
    assert_eq(input_decode_actions(esc_seq("[C"), 3), ACT_RIGHT, "ESC restarts, then right");
    # the key mapping
    assert_eq(input_feed(65), 65, "a plain byte is itself");
    assert_eq(bb_key_action(3), ACT_QUIT, "Ctrl-C -> QUIT");
    assert_eq(bb_key_action(KEY_LEFT), ACT_LEFT, "KEY_LEFT -> LEFT");
    assert_eq(bb_key_action(KEY_RIGHT), ACT_RIGHT, "KEY_RIGHT -> RIGHT");
    assert_eq(bb_key_action(112), ACT_PAUSE, "'p' -> PAUSE");
    # menu navigation
    assert_eq(input_decode_nav(esc_seq("[A"), 3), NAV_UP, "up arrow -> UP");
    assert_eq(input_decode_nav(esc_seq("[B"), 3), NAV_DOWN, "down arrow -> DOWN");
    assert_eq(input_decode_nav(esc_seq("[C"), 3), NAV_NONE, "right arrow does nothing");
    assert_eq(input_decode_nav(esc_seq("["), 2), NAV_NONE, "split arrow is not BACK");
    assert_eq(input_decode_nav("A", 1), NAV_UP, "and completes as UP");
    assert_eq(input_decode_nav(esc_seq(""), 1), NAV_NONE, "lone ESC waits");
    assert_eq(input_decode_nav(0, 0), NAV_BACK, "then is BACK");
    assert_eq(input_nav_key(119), NAV_UP, "w");
    assert_eq(input_nav_key(107), NAV_UP, "k");
    assert_eq(input_nav_key(115), NAV_DOWN, "s");
    assert_eq(input_nav_key(106), NAV_DOWN, "j");
    assert_eq(input_nav_key(10), NAV_SELECT, "LF");
    assert_eq(input_nav_key(13), NAV_SELECT, "CR");
    assert_eq(input_nav_key(32), NAV_SELECT, "space");
    assert_eq(input_nav_key(113), NAV_BACK, "q");
    assert_eq(input_nav_key(3), NAV_BACK, "Ctrl-C");
    assert_eq(input_nav_key(120), NAV_NONE, "x");
    # the first action wins, but later bytes still advance the decoder
    var mix = alloc(3);
    store8(mix, 119);
    store8(mix + 1, 27);
    store8(mix + 2, 91);
    assert_eq(input_decode_nav(mix, 3), NAV_UP, "w wins over the ESC [ after it");
    assert_eq(input_decode_nav("B", 1), NAV_DOWN, "that sequence still completes next read");
    return 0;
}

fn test_input_settle() {
    test_group("input settle + hold");
    assert_eq(input_settle_step(5, 65), 0, "a key restarts the quiet count");
    assert_eq(input_settle_step(5, KEY_LEFT), 0, "so does an arrow");
    assert_eq(input_settle_step(5, 0 - 1), 6, "a quiet frame counts");
    assert_eq(input_settle_step(INPUT_SETTLE_FRAMES, 0 - 1), INPUT_SETTLE_FRAMES, "the count saturates");
    assert_eq(input_settled(INPUT_SETTLE_FRAMES - 1), 0, "not settled one frame early");
    assert_eq(input_settled(INPUT_SETTLE_FRAMES), 1, "settled at the threshold");
    assert_eq(INPUT_SETTLE_FRAMES > PADDLE_HOLD_FRAMES, 1, "settle outlasts a repeat gap");
    assert_eq(input_hold_dir(4, 0, ACT_RIGHT), 0, "the opposite key drops the latch at once");
    assert_eq(input_hold_dir(4, ACT_LEFT, 0), PADDLE_HOLD_FRAMES, "its own key re-arms it");
    assert_eq(input_hold_dir(4, 0, 0), 3, "no key decays it");
    assert_eq(input_hold_dir(4, ACT_LEFT, ACT_RIGHT), PADDLE_HOLD_FRAMES, "both keys in a frame still arms it");
    return 0;
}

fn test_initials() {
    test_group("initials");
    var ini[3];
    store8(&ini, 65);
    store8(&ini + 1, 65);
    store8(&ini + 2, 65);
    assert_eq(initials_apply(&ini, 0, 98), 1, "letter advances");
    assert_eq(load8(&ini), 66, "lower case folds up");
    assert_eq(initials_apply(&ini, 1, 67), 2, "upper case advances");
    assert_eq(load8(&ini + 1), 67, "stored");
    assert_eq(initials_apply(&ini, 2, KEY_LEFT), 2, "an arrow types nothing");
    assert_eq(initials_apply(&ini, 2, KEY_ESC), 2, "Esc types nothing");
    assert_eq(initials_apply(&ini, 2, 53), 2, "a digit types nothing");
    assert_eq(load8(&ini + 2), 65, "and the slot is untouched");
    assert_eq(initials_apply(&ini, 2, 122), 3, "last slot fills");
    assert_eq(load8(&ini + 2), 90, "z folds to Z");
    assert_eq(initials_apply(&ini, 3, 88), 3, "a full field ignores letters");
    assert_eq(load8(&ini + 2), 90, "and keeps its last letter");
    assert_eq(initials_apply(&ini, 3, 127), 2, "DEL steps back");
    assert_eq(initials_apply(&ini, 2, 8), 1, "Backspace steps back");
    assert_eq(initials_apply(&ini, 0, 127), 0, "and stops at the start");
    assert_eq(initials_apply(&ini, 1, 13), INITIALS_DONE, "CR finishes");
    assert_eq(initials_apply(&ini, 1, 10), INITIALS_DONE, "LF finishes");
    return 0;
}

# A 2x1 brick row: brick 0 at x 50..68, brick 1 at x 70..88, y 55..71.
fn side_world(x, y, vx, vy): i64 {
    var b = ball_new(fixed_from_int(x), fixed_from_int(y), vx, vy, fixed_from_int(3));
    var p = paddle_new(fixed_from_int(80), fixed_from_int(138), fixed_from_int(40), fixed_from_int(6));
    var g = bricks_new(2, 1, fixed_from_int(50), fixed_from_int(55), fixed_from_int(18), fixed_from_int(16), fixed_from_int(2), fixed_from_int(2), 10);
    return world_new(b, p, g, fixed_from_int(200), fixed_from_int(150), 3, fixed_from_int(5));
}

fn test_world_side() {
    test_group("world side hits");
    var four = fixed_from_int(4);
    var two = fixed_from_int(2);
    # moving right into the row's left end
    var wd = side_world(46, 60, four, 0 - two);
    world_step(wd);
    assert_eq(world_last_hit(wd), 0, "left face: brick 0 hit");
    assert_eq(ball_vx(world_ball(wd)), 0 - four, "left face flips vx");
    assert_eq(ball_vy(world_ball(wd)), 0 - two, "left face keeps vy");
    # moving left into the row's right end
    wd = side_world(92, 60, 0 - four, 0 - two);
    world_step(wd);
    assert_eq(world_last_hit(wd), 1, "right face: brick 1 hit");
    assert_eq(ball_vx(world_ball(wd)), four, "right face flips vx");
    assert_eq(ball_vy(world_ball(wd)), 0 - two, "right face keeps vy");
    # rising into the underside
    wd = side_world(60, 74, FIXED_ONE, 0 - four);
    world_step(wd);
    assert_eq(world_last_hit(wd), 0, "underside: brick 0 hit");
    assert_eq(ball_vx(world_ball(wd)), FIXED_ONE, "underside keeps vx");
    assert_eq(ball_vy(world_ball(wd)), four, "underside flips vy");
    # under the seam, the inner face is covered by the live neighbour
    wd = side_world(74, 71, 0 - four, 0 - two);
    world_step(wd);
    assert_eq(world_last_hit(wd), 0, "seam: brick 0 hit");
    assert_eq(ball_vx(world_ball(wd)), 0 - four, "a covered side keeps vx");
    assert_eq(ball_vy(world_ball(wd)), two, "a covered side flips vy");
    # ...and once the neighbour is gone that face is a real side
    wd = side_world(74, 71, 0 - four, 0 - two);
    brick_destroy(world_bricks(wd), 1);
    world_step(wd);
    assert_eq(ball_vx(world_ball(wd)), four, "an exposed inner face flips vx");
    assert_eq(ball_vy(world_ball(wd)), 0 - two, "and keeps vy");
    # the pure pieces
    assert_eq(hit_is_side(0, 0, 6 << 16, 0, four, 0, 0, 18 << 16, 8 << 16), 0, "vx == 0 is never a side");
    # both depths 2 at equal speeds: the two edges were crossed together
    assert_eq(hit_is_side(0 - (4 << 16), 0 - (4 << 16), 6 << 16, four, four, 0, 0, 18 << 16, 8 << 16), 0, "a tie counts as top/bottom");
    assert_eq(brick_side_open(world_bricks(side_world(0, 0, 0, 0)), 0, four), 1, "row start, moving right: open");
    assert_eq(brick_side_open(world_bricks(side_world(0, 0, 0, 0)), 1, 0 - four), 1, "row end, moving left: open");
    assert_eq(brick_side_open(world_bricks(side_world(0, 0, 0, 0)), 1, four), 0, "brick 1's left face is covered");
    return 0;
}

fn test_render() {
    test_group("render");
    var f = fb_new(40, 30);
    var b = ball_new(fixed_from_int(20), fixed_from_int(15), 0, 0, fixed_from_int(2));
    var p = paddle_new(fixed_from_int(10), fixed_from_int(26), fixed_from_int(12), fixed_from_int(2));
    var g = bricks_new(2, 1, fixed_from_int(4), fixed_from_int(4), fixed_from_int(8), fixed_from_int(4), fixed_from_int(2), 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(40), fixed_from_int(30), 3, fixed_from_int(4));
    render_world(f, wd);
    # beveled brick: lit top-left edge over a tier-coloured interior face
    assert_eq(fb_get(f, 4, 4, 0), lighten(rgb_r(tier_rgb(1)), 70), "brick top-left bevel highlight");
    assert_eq(fb_get(f, 6, 5, 0), rgb_r(tier_rgb(1)), "brick interior face R = tier 1");
    assert_eq(fb_get(f, 6, 5, 1), rgb_g(tier_rgb(1)), "brick interior face G = tier 1");
    assert_eq(fb_get(f, 6, 5, 2), rgb_b(tier_rgb(1)), "brick interior face B = tier 1");
    # 2px extrusion shadow shows past the face's bottom-right edge
    assert_eq(fb_get(f, 12, 8, 0), 10, "brick extrusion shadow");
    # paddle: lit top edge over a green body
    assert_eq(fb_get(f, 11, 26, 1), 240, "paddle lit top edge");
    assert_eq(fb_get(f, 11, 27, 1), 168, "paddle body green");
    # ball: rounded body + bright highlight
    assert_eq(fb_get(f, 20, 16, 0), 235, "ball body");
    assert_eq(fb_get(f, 19, 14, 0), 255, "ball highlight");
    # destroyed brick no longer paints its tier colour
    brick_destroy(g, 0);
    render_world(f, wd);
    assert_eq(fb_get(f, 6, 5, 0) != rgb_r(tier_rgb(1)), 1, "destroyed brick interior -> not tier");
    return 0;
}

fn test_colors() {
    test_group("colors");
    assert_eq(rgb_r(tier_rgb(1)), 80, "tier 1 R");
    assert_eq(rgb_g(tier_rgb(1)), 180, "tier 1 G");
    assert_eq(rgb_b(tier_rgb(1)), 240, "tier 1 B");
    assert_eq(rgb_r(tier_rgb(9)), 210, "tier 9 R");
    assert_eq(tier_rgb(0), 0, "empty tier -> black");
    assert_eq(tier_rgb(1) != tier_rgb(9), 1, "tiers differ in colour");
    return 0;
}

fn test_bg() {
    test_group("bg");
    var f = fb_new(60, 30);
    var b = ball_new(fixed_from_int(0), fixed_from_int(15), 0, 0, fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(28), fixed_from_int(10), fixed_from_int(2));
    var g = bricks_new(1, 1, fixed_from_int(4), fixed_from_int(4), fixed_from_int(8), fixed_from_int(4), 0, 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(60), fixed_from_int(30), 3, fixed_from_int(4));
    render_bg(f, wd);
    var v0 = fb_get(f, 2, 20, 0);
    ball_set_x(b, fixed_from_int(80));
    render_bg(f, wd);
    var v1 = fb_get(f, 2, 20, 0);
    assert_eq(v0 != v1, 1, "parallax bg shifts with ball x");
    return 0;
}

fn test_fx() {
    test_group("fx");
    var fx = fx_new(8);
    assert_eq(fx_active(fx), 0, "pool starts empty");
    fx_debris(fx, 50, 50, 200, 100, 50);
    assert_eq(fx_active(fx), 5, "debris burst = 5 shards");
    fx_collapse(fx, 50, 50, 18, 200, 100, 50);
    assert_eq(fx_active(fx), 6, "collapse adds 1");
    fx_debris(fx, 10, 10, 1, 2, 3);
    assert_eq(fx_active(fx), 8, "spawns capped at capacity");
    # one known particle: integration + gravity + ageing
    var fx2 = fx_new(4);
    fx_spawn(fx2, 30, 40, fixed_from_int(2), 0 - fixed_from_int(3), 10, 3, 9, 9, 9);
    assert_eq(fx_p_x(fx2, 0), fixed_from_int(30), "spawn x");
    assert_eq(fx_p_life(fx2, 0), 10, "spawn life");
    fx_step(fx2);
    assert_eq(fx_p_x(fx2, 0), fixed_from_int(32), "x += vx");
    assert_eq(fx_p_y(fx2, 0), fixed_from_int(40) - fixed_from_int(3), "y += vy");
    assert_eq(fx_p_vy(fx2, 0), (0 - fixed_from_int(3)) + asr(FIXED_ONE, 2), "vy += gravity");
    assert_eq(fx_p_life(fx2, 0), 9, "life decremented");
    var k = 0;
    while (k < 10) { fx_step(fx2); k += 1; }
    assert_eq(fx_active(fx2), 0, "particles expire to free slots");
    return 0;
}

fn test_hud() {
    test_group("hud");
    hud_init();
    var f = fb_new(20, 10);
    fb_clear(f, 0, 0, 0);
    # digit '1' at (0,0) scale 1: rows 010/110/010/010/111
    hud_draw_digit(f, 0, 0, 1, 1, 255, 255, 255);
    assert_eq(fb_get(f, 1, 0, 0), 255, "'1' top-middle on");
    assert_eq(fb_get(f, 0, 0, 0), 0, "'1' top-left off");
    assert_eq(fb_get(f, 0, 4, 0), 255, "'1' bottom row on");
    assert_eq(fb_get(f, 2, 4, 0), 255, "'1' bottom-right on");
    # digit '0': row1 = 101 -> centre hole
    fb_clear(f, 0, 0, 0);
    hud_draw_number(f, 0, 0, 0, 1, 255, 255, 255);
    assert_eq(fb_get(f, 0, 0, 0), 255, "'0' top-left on");
    assert_eq(fb_get(f, 1, 0, 0), 255, "'0' top-middle on");
    assert_eq(fb_get(f, 1, 1, 0), 0, "'0' centre hole");
    assert_eq(fb_get(f, 2, 1, 0), 255, "'0' right side on");
    # out-of-range digit is ignored (no crash, nothing drawn)
    fb_clear(f, 0, 0, 0);
    hud_draw_digit(f, 0, 0, 42, 1, 255, 255, 255);
    assert_eq(fb_get(f, 0, 0, 0), 0, "bad digit draws nothing");
    # letter 'A' (idx 0) = rows 010/101/111/101/101
    fb_clear(f, 0, 0, 0);
    hud_draw_letter(f, 0, 0, 0, 1, 255, 255, 255);
    assert_eq(fb_get(f, 1, 0, 0), 255, "'A' top-middle on");
    assert_eq(fb_get(f, 0, 0, 0), 0, "'A' top-left off");
    assert_eq(fb_get(f, 0, 2, 0), 255, "'A' crossbar row left on");
    # hud_draw_char maps ASCII 'Z' (90) -> letter 25
    fb_clear(f, 0, 0, 0);
    hud_draw_char(f, 0, 0, 90, 1, 255, 255, 255);
    assert_eq(fb_get(f, 0, 0, 0), 255, "'Z' top-left on");
    assert_eq(fb_get(f, 0, 4, 0), 255, "'Z' bottom-left on");
    hud_draw_char(f, 10, 0, 64, 1, 255, 255, 255);
    assert_eq(fb_get(f, 10, 0, 0), 0, "'@' (non-letter) draws nothing");
    return 0;
}

fn test_input() {
    test_group("input");
    assert_eq(bb_key_action(97), ACT_LEFT, "'a' -> LEFT");
    assert_eq(bb_key_action(100), ACT_RIGHT, "'d' -> RIGHT");
    assert_eq(bb_key_action(32), ACT_LAUNCH, "space -> LAUNCH");
    assert_eq(bb_key_action(113), ACT_QUIT, "'q' -> QUIT");
    assert_eq(bb_key_action(27), ACT_QUIT, "ESC -> QUIT");
    assert_eq(bb_key_action(109), ACT_MUTE, "'m' -> MUTE");
    assert_eq(bb_key_action(120), 0, "'x' -> no action");
    # key-held latch: arming re-loads to PADDLE_HOLD_FRAMES, idle decays to 0
    assert_eq(input_hold_step(0, 1), PADDLE_HOLD_FRAMES, "armed -> full latch");
    assert_eq(input_hold_step(PADDLE_HOLD_FRAMES, 0), PADDLE_HOLD_FRAMES - 1, "idle decays by 1");
    assert_eq(input_hold_step(1, 0), 0, "decays to 0");
    assert_eq(input_hold_step(0, 0), 0, "stays at 0 when idle");
    assert_eq(input_hold_step(2, ACT_LEFT), PADDLE_HOLD_FRAMES, "action bit re-arms latch");
    return 0;
}

fn test_world_serve() {
    test_group("world serve");
    var b = ball_new(fixed_from_int(100), fixed_from_int(204), 0, fixed_from_int(2), fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(10), fixed_from_int(10), fixed_from_int(8), fixed_from_int(4), 0, 0, 10);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 3, fixed_from_int(4));
    world_step(wd);
    assert_eq(world_state(wd), WS_BALL_LOST, "ball lost first");
    world_serve(wd, fixed_from_int(100), fixed_from_int(100), fixed_from_int(1), 0 - fixed_from_int(3));
    assert_eq(world_state(wd), WS_PLAYING, "serve resumes play");
    assert_eq(ball_y(world_ball(wd)), fixed_from_int(100), "ball repositioned");
    assert_eq(ball_vy(world_ball(wd)), 0 - fixed_from_int(3), "ball re-served velocity");
    return 0;
}

fn test_level() {
    test_group("level");
    # cell char -> tier mapping
    assert_eq(cell_tier(49), 1, "'1' -> tier 1");
    assert_eq(cell_tier(57), 9, "'9' -> tier 9");
    assert_eq(cell_tier(35), 1, "'#' -> tier 1");
    assert_eq(cell_tier(46), 0, "'.' -> empty");
    assert_eq(cell_tier(32), 0, "space -> empty");
    # parser on an ad-hoc layout with a gap and a short line
    assert_eq(layout_cols(".1.\n22.\n"), 3, "cols = longest line");
    assert_eq(layout_rows(".1.\n22.\n"), 2, "rows = line count");
    assert_eq(layout_count(".1.\n22.\n"), 3, "count = live cells");
    # shipped layouts: 5 levels, increasing brick count
    assert_eq(level_count(), 5, "five levels");
    assert_eq(layout_count(level_layout(0)), 18, "L1 brick count");
    assert_eq(layout_count(level_layout(1)), 25, "L2 brick count");
    assert_eq(layout_count(level_layout(2)), 34, "L3 brick count");
    assert_eq(layout_count(level_layout(3)), 40, "L4 brick count");
    assert_eq(layout_count(level_layout(4)), 49, "L5 brick count");
    # built grid: total = cols*rows, alive = live cells (L4 has gaps)
    var g1 = level_make_bricks(0, 200);
    assert_eq(bricks_total(g1), 18, "L1 grid 9x2");
    assert_eq(bricks_alive_count(g1), 18, "L1 all cells live");
    assert_eq(brick_tier(g1, 0), 3, "L1 top row tier 3");
    assert_eq(brick_tier(g1, 9), 1, "L1 bottom row tier 1");
    assert_eq(brick_destroy(g1, 0), 30, "tier 3 brick = 30 pts");
    assert_eq(brick_destroy(g1, 9), 10, "tier 1 brick = 10 pts");
    var g4 = level_make_bricks(3, 200);
    assert_eq(bricks_total(g4), 45, "L4 grid 9x5");
    assert_eq(bricks_alive_count(g4), 40, "L4 has 5 gap cells");
    # target speed climbs gently across levels (the difficulty knob)
    assert_eq(level_speed(0), fixed_from_int(5), "L1 target speed = 5");
    assert_eq(level_speed(4), fixed_from_int(7), "L5 target speed = 7");
    assert_eq(level_speed(4) > level_speed(0), 1, "target speed climbs");
    # serve velocity ~ (3, -4) at L1 along the 3-4-5 line, faster at L5
    assert_eq(near(level_serve_vx(0), fixed_from_int(3), 64), 1, "L1 serve vx ~ 3");
    assert_eq(near(level_serve_vy(0), 0 - fixed_from_int(4), 64), 1, "L1 serve vy ~ -4");
    assert_eq(fixed_abs(level_serve_vy(4)) > fixed_abs(level_serve_vy(0)), 1, "serve faster at L5");
    # serve magnitude == target speed (speed-conserving, no edge-hit drift)
    assert_eq(near(fixed_mul(level_serve_vx(0), level_serve_vx(0)) + fixed_mul(level_serve_vy(0), level_serve_vy(0)), fixed_mul(level_speed(0), level_speed(0)), fixed_from_int(1)), 1, "L1 serve |v| = target speed");
    # the fastest vertical travel is a centre rebound (vy = speed); it must
    # stay under the brick height (8) so the ball can't tunnel a row
    assert_eq(fixed_abs(paddle_rebound_vy(0, level_speed(LEVEL_COUNT - 1))) < fixed_from_int(LV_BH), 1, "L5 centre rebound vy < brick height");
    return 0;
}

fn test_rebound() {
    test_group("rebound");
    var s = fixed_from_int(5);
    # centre hit -> straight up at full speed (vx 0, vy = -speed)
    assert_eq(paddle_rebound_vx(0, s), 0, "centre rebound vx = 0");
    assert_eq(paddle_rebound_vy(0, s), 0 - fixed_from_int(5), "centre rebound vy = -speed");
    # english sign sets the vx direction; vy is always upward
    assert_eq(paddle_rebound_vx(FIXED_ONE, s) > 0, 1, "right english -> vx > 0");
    assert_eq(paddle_rebound_vx(0 - FIXED_ONE, s) < 0, 1, "left english -> vx < 0");
    assert_eq(paddle_rebound_vy(FIXED_ONE, s) < 0, 1, "edge rebound still upward");
    # speed conserved across the whole english range (unit-vector zones):
    # |v|^2 stays ~ speed^2 regardless of where the ball strikes
    var s2 = fixed_mul(s, s);
    var e = 0 - FIXED_ONE;
    while (e <= FIXED_ONE) {
        var vx = paddle_rebound_vx(e, s);
        var vy = paddle_rebound_vy(e, s);
        assert_eq(near(fixed_mul(vx, vx) + fixed_mul(vy, vy), s2, fixed_from_int(1)), 1, "rebound conserves speed");
        e = e + asr(FIXED_ONE, 2);
    }
    return 0;
}

fn test_level_progress() {
    test_group("level progress");
    # mid-game world: 1-brick level, score in flight, 2 lives left
    var b = ball_new(fixed_from_int(50), fixed_from_int(48), 0, fixed_from_int(2), fixed_from_int(2));
    var p = paddle_new(0, fixed_from_int(195), fixed_from_int(20), fixed_from_int(4));
    var g = bricks_new(1, 1, fixed_from_int(45), fixed_from_int(45), fixed_from_int(10), fixed_from_int(10), 0, 0, 100);
    var wd = world_new(b, p, g, fixed_from_int(200), fixed_from_int(200), 2, fixed_from_int(4));
    world_step(wd);
    assert_eq(world_state(wd), WS_LEVEL_CLEAR, "single brick cleared");
    assert_eq(world_score(wd), 100, "score before advancing");
    # advance into level 1 (the 25-brick cascade)
    level_load(wd, 1, 200, fixed_from_int(100), fixed_from_int(110));
    assert_eq(world_state(wd), WS_PLAYING, "level_load resumes play");
    assert_eq(world_score(wd), 100, "score carries across levels");
    assert_eq(world_lives(wd), 2, "lives carry across levels");
    assert_eq(bricks_alive_count(world_bricks(wd)), 25, "next level's bricks loaded");
    assert_eq(ball_vy(world_ball(wd)), level_serve_vy(1), "ball re-served at level speed");
    assert_eq(ball_y(world_ball(wd)), fixed_from_int(110), "ball repositioned to serve y");
    return 0;
}

# Signed S16 sample of channel ch (0 = L, 1 = R) in frame f of buf.
fn t_s16(buf, f, ch): i64 {
    var v = load16(buf + f * AUDIO_FRAME_BYTES + ch * 2);
    if (v >= 32768) { v = v - 65536; }
    return v;
}

# Frames in [0, n) whose L != R, or whose sample exceeds +/-amp.
fn t_frame_faults(buf, n, amp): i64 {
    var bad = 0;
    var f = 0;
    var s = 0;
    while (f < n) {
        s = t_s16(buf, f, 0);
        if (s != t_s16(buf, f, 1)) { bad = bad + 1; }
        else { if ((s > amp) || (s < (0 - amp))) { bad = bad + 1; } }
        f = f + 1;
    }
    return bad;
}

fn test_audio() {
    test_group("audio");
    audio_init();
    # the device's own format: the probed codec rejects 11025 Hz 8-bit mono
    assert_eq(AUDIO_RATE, 48000, "renders at 48 kHz");
    assert_eq(AUDIO_FRAME_BYTES, AUDIO_CHANNELS * 2, "frame = channels x 16-bit");
    assert_eq(ms_frames(1000), 48000, "1 s = AUDIO_RATE frames");
    assert_eq(ms_frames(55), 2640, "55 ms frame count");
    var buf = alloc(64 * AUDIO_FRAME_BYTES);
    # square wave at 1000 Hz -> half-period = 48000/(2*1000) = 24 frames
    synth_tone(buf, 0, 64, 1000, 1000, 10000, 10000);
    assert_eq(t_s16(buf, 0, 0), 10000, "square hi = +amp");
    assert_eq(t_s16(buf, 23, 0), 10000, "still hi through first half-period");
    assert_eq(t_s16(buf, 24, 0), 0 - 10000, "flips to lo = -amp");
    assert_eq(t_s16(buf, 47, 0), 0 - 10000, "still lo through second half-period");
    assert_eq(t_s16(buf, 48, 0), 10000, "flips back to hi");
    # S16_LE: -10000 = 0xD8F0, low byte first; right channel mirrors left
    assert_eq(load8(buf + 24 * AUDIO_FRAME_BYTES), 240, "S16_LE low byte first");
    assert_eq(load8(buf + 24 * AUDIO_FRAME_BYTES + 1), 216, "S16_LE high byte second");
    assert_eq(t_s16(buf, 24, 1), 0 - 10000, "right channel = left");
    assert_eq(t_frame_faults(buf, 64, 10000), 0, "every frame L == R, within +/-amp");
    # amp 0 -> digital silence (0) regardless of phase
    synth_tone(buf, 0, 64, 1000, 1000, 0, 0);
    assert_eq(t_s16(buf, 0, 0), 0, "amp 0 -> silence");
    assert_eq(t_s16(buf, 40, 1), 0, "amp 0 -> silence later");
    # amplitude envelope: frame 0 carries a0; frame 24 (low half) is at
    # a0 + (a1 - a0) * 24 / 64 = 20480 - 7680
    synth_tone(buf, 0, 64, 1000, 1000, 20480, 0);
    assert_eq(t_s16(buf, 0, 0), 20480, "amp envelope starts at a0");
    assert_eq(t_s16(buf, 24, 0), 0 - 12800, "amp envelope decays linearly");
    # off is a frame index: only frames [off, off+len) are written
    assert_eq(synth_tone(buf, 32, 8, 1000, 1000, 0, 0), 8, "returns frames written");
    assert_eq(t_s16(buf, 31, 0), 0 - 10560, "frame before off untouched");
    assert_eq(t_s16(buf, 32, 0), 0, "tone lands at frame off");
    assert_eq(t_s16(buf, 40, 0), 0 - 7680, "frame after off+len untouched");
    # SFX cache: frame counts at 48 kHz
    assert_eq(sfx_len(SFX_PADDLE), 1920, "paddle blip = 40 ms");
    assert_eq(sfx_len(SFX_BRICK), 2640, "brick chirp = 55 ms");
    assert_eq(sfx_len(SFX_WALL), 2640, "wall thud = 55 ms");
    assert_eq(sfx_len(SFX_LOST), 10560, "ball-lost blip = 220 ms");
    assert_eq(sfx_len(SFX_OVER), 28800, "game-over sting = 600 ms");
    assert_eq(sfx_len(SFX_FANFARE), ms_frames(90) * 4, "fanfare = 4 segments");
    # cues start as audible PCM, and stay L == R within their peak amplitude
    assert_eq(t_s16(sfx_buf(SFX_PADDLE), 0, 0), 17920, "cue begins with a tone sample");
    assert_eq(t_frame_faults(sfx_buf(SFX_OVER), sfx_len(SFX_OVER), 23040), 0, "sting frames L == R, within +/-amp");
    assert_eq(t_frame_faults(sfx_buf(SFX_FANFARE), sfx_len(SFX_FANFARE), 19200), 0, "fanfare frames L == R, within +/-amp");
    # mute toggle
    audio_set_mute(0);
    assert_eq(audio_muted(), 0, "starts unmuted");
    assert_eq(audio_toggle_mute(), 1, "toggle -> muted");
    assert_eq(audio_muted(), 1, "muted");
    audio_toggle_mute();
    assert_eq(audio_muted(), 0, "toggle -> unmuted");
    return 0;
}

# The device shell's pure pieces (src/sound.cyr). No /dev/snd in CI, so
# snd_dev stays 0: sound_open is never called here.
fn test_sound() {
    test_group("sound");
    # ring shape: whole periods, within HD-Audio's 32-period cap
    assert_eq(SND_BUFFER_FRAMES % SND_PERIOD_FRAMES, 0, "ring is whole periods");
    assert_eq(SND_BUFFER_FRAMES / SND_PERIOD_FRAMES <= 32, 1, "<= 32 periods (HD-Audio cap)");
    # the ring holds a whole tick's cues, so a write to an idle ring never
    # blocks: a loss can share its tick with a wall hit, a level clear with a
    # wall hit and its last brick (world_step)
    assert_eq(sfx_len(SFX_WALL) + sfx_len(SFX_OVER) <= SND_BUFFER_FRAMES, 1, "wall + game-over sting fits the ring");
    assert_eq(sfx_len(SFX_WALL) + sfx_len(SFX_BRICK) + sfx_len(SFX_FANFARE) <= SND_BUFFER_FRAMES, 1, "wall + brick + fanfare fits the ring");
    # write-failure policy: only XRUN / suspend are worth a PREPARE + retry
    assert_eq(sound_write_recoverable(0 - 32), 1, "-EPIPE (ring ran dry) re-prepares");
    assert_eq(sound_write_recoverable(0 - 86), 1, "-ESTRPIPE (suspended) re-prepares");
    assert_eq(sound_write_recoverable(1920), 0, "a landed write needs no recovery");
    assert_eq(sound_write_recoverable(0 - 19), 0, "-ENODEV (unplugged) is not retried");
    assert_eq(sound_write_recoverable(0 - 77), 0, "-EBADFD is not retried");
    assert_eq(sound_write_recoverable(0 - 1), 0, "vani's -1 (bad handle / args) is not retried");
    # no device: play is a silent no-op, muted or not
    assert_eq(sound_play(SFX_BRICK), 0, "no-device play is a no-op");
    audio_set_mute(1);
    assert_eq(sound_play(SFX_BRICK), 0, "muted play is a no-op");
    # muted with a device open must not touch it: audio_write would fault
    # on this handle, so reaching the device fails the run
    snd_dev = 1;
    assert_eq(sound_play(SFX_BRICK), 0, "muted play never reaches the device");
    snd_dev = 0;
    audio_set_mute(0);
    return 0;
}

fn test_save_file() {
    test_group("save file");
    var path = test_scratch("bb_scores_fixture");
    var t = hs_new();
    hs_insert(t, 65, 66, 67, 4242);
    var n = hs_save_to(t, path);
    assert_eq(n > 40, 1, "save reports the bytes written");
    var rb[256];
    assert_eq(file_read_all(path, &rb, 256), n, "the whole file landed");
    var u = hs_new();
    assert_eq(hs_decode(u, &rb, n), 0, "it decodes");
    assert_eq(hs_score(u, 0), 4242, "with its score");
    hs_insert(t, 68, 69, 70, 9000);
    n = hs_save_to(t, path);
    assert_eq(file_read_all(path, &rb, 256), n, "a second save replaces the file");
    var v = hs_new();
    assert_eq(hs_decode(v, &rb, n), 0, "and decodes");
    assert_eq(hs_score(v, 0), 9000, "with the new top score");
    sys_unlink(path);
    assert_eq(hs_save_to(t, "/nonexistent-cyrius-bb-dir/scores.cyb") < 0, 1, "an unwritable path reports an error");
    return 0;
}

fn test_scores() {
    test_group("scores");
    var t = hs_new();
    assert_eq(hs_count(t), 0, "empty table");
    assert_eq(hs_qualifies(t, 100), 1, "positive qualifies when empty");
    assert_eq(hs_qualifies(t, 0), 0, "zero never qualifies");
    # insert (A=65, B=66, C=67); kept sorted descending
    assert_eq(hs_insert(t, 65, 65, 65, 100), 0, "first insert -> rank 0");
    assert_eq(hs_insert(t, 66, 66, 66, 300), 0, "higher score -> rank 0");
    assert_eq(hs_insert(t, 67, 67, 67, 200), 1, "middle score -> rank 1");
    assert_eq(hs_count(t), 3, "three entries");
    assert_eq(hs_score(t, 0), 300, "top = 300");
    assert_eq(hs_score(t, 1), 200, "middle = 200");
    assert_eq(hs_score(t, 2), 100, "bottom = 100");
    assert_eq(hs_initial(t, 0, 0), 66, "top initials = B");
    # overflow: fill past 10, cap holds and the lowest drops
    var i = 0;
    while (i < 10) {
        hs_insert(t, 90, 90, 90, 1000 + i * 10);
        i += 1;
    }
    assert_eq(hs_count(t), 10, "capped at 10");
    assert_eq(hs_qualifies(t, 50), 0, "below lowest -> no");
    assert_eq(hs_qualifies(t, 100000), 1, "above top -> yes");
    # serialize round-trip
    var sbuf[256];
    var slen = hs_serialize(t, &sbuf);
    var t2 = hs_new();
    assert_eq(hs_deserialize(t2, &sbuf, slen), 0, "deserialize ok");
    assert_eq(hs_count(t2), hs_count(t), "count round-trips");
    assert_eq(hs_score(t2, 0), hs_score(t, 0), "top score round-trips");
    # encode/decode round-trip (sankoch zlib + sigil hmac)
    var ebuf[256];
    var elen = hs_encode(t, &ebuf, 256);
    assert_eq(elen > 40, 1, "encoded length past header");
    var t3 = hs_new();
    assert_eq(hs_decode(t3, &ebuf, elen), 0, "decode ok");
    assert_eq(hs_score(t3, 0), hs_score(t, 0), "decoded top score matches");
    assert_eq(hs_initial(t3, 0, 0), hs_initial(t, 0, 0), "decoded initials match");
    # tamper: flip an HMAC byte -> rejected (-2), table left untouched
    store8(&ebuf + 10, load8(&ebuf + 10) ^ 255);
    var t4 = hs_new();
    assert_eq(hs_decode(t4, &ebuf, elen), 0 - 2, "tampered HMAC -> -2");
    assert_eq(hs_count(t4), 0, "table untouched on tamper");
    # bad magic -> malformed
    var junk[64];
    var j = 0;
    while (j < 64) {
        store8(&junk + j, j);
        j += 1;
    }
    assert_eq(hs_decode(hs_new(), &junk, 64), 0 - 1, "bad magic -> -1");
    return 0;
}

